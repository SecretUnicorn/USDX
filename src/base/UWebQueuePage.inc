{* UltraStar Deluxe - Karaoke Game
 *
 * Song request page served by UWebServer. Kept in a separate include file to
 * keep the server unit readable. The page is completely self contained, the
 * game does not serve any other file.
 *}

function BuildWebQueuePage: RawByteString;
var
  S: TStringList;
begin
  S := TStringList.Create;
  try
    S.Add('<!DOCTYPE html>');
    S.Add('<html lang="en">');
    S.Add('<head>');
    S.Add('<meta charset="utf-8">');
    S.Add('<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">');
    S.Add('<title>UltraStar Deluxe - Song Requests</title>');
    S.Add('<style>');
    S.Add(':root{--bg:#111420;--panel:#1b2030;--panel2:#232a3d;--line:#2e3752;--text:#e9ecf6;--dim:#98a1bb;--accent:#ffc933;--accent2:#5ad1a0;}');
    S.Add('*{box-sizing:border-box;}');
    S.Add('body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:16px;padding-bottom:32px;}');
    S.Add('header{position:sticky;top:0;z-index:5;background:var(--panel);border-bottom:1px solid var(--line);padding:10px 12px 12px;}');
    S.Add('h1{margin:0 0 8px;font-size:17px;letter-spacing:.02em;}');
    S.Add('h1 span{color:var(--accent);}');
    S.Add('.row{display:flex;gap:8px;}');
    S.Add('input[type=text],input[type=search]{flex:1;min-width:0;background:var(--panel2);border:1px solid var(--line);border-radius:9px;color:var(--text);padding:11px 12px;font-size:16px;}');
    S.Add('input::placeholder{color:var(--dim);}');
    S.Add('input:focus{outline:2px solid var(--accent);outline-offset:0;}');
    S.Add('main{padding:12px;max-width:760px;margin:0 auto;}');
    S.Add('section{margin-bottom:18px;}');
    S.Add('h2{font-size:13px;text-transform:uppercase;letter-spacing:.09em;color:var(--dim);margin:0 0 8px;display:flex;justify-content:space-between;align-items:center;}');
    S.Add('ul{list-style:none;margin:0;padding:0;}');
    S.Add('li{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:9px 10px;margin-bottom:7px;display:flex;align-items:center;gap:10px;}');
    S.Add('li.now{border-color:var(--accent);}');
    S.Add('.meta{flex:1;min-width:0;}');
    S.Add('.title{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}');
    S.Add('.sub{color:var(--dim);font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px;}');
    S.Add('.pos{color:var(--accent);font-weight:700;min-width:22px;text-align:center;}');
    S.Add('button{background:var(--panel2);color:var(--text);border:1px solid var(--line);border-radius:9px;padding:9px 12px;font-size:15px;cursor:pointer;}');
    S.Add('button:active{transform:scale(.96);}');
    S.Add('button.add{background:var(--accent);border-color:var(--accent);color:#241d00;font-weight:700;min-width:44px;}');
    S.Add('button.icon{min-width:40px;padding:9px 0;}');
    S.Add('.empty{color:var(--dim);font-size:14px;padding:6px 2px;}');
    S.Add('.more{width:100%;margin-top:4px;}');
    S.Add('.badge{background:var(--panel2);border-radius:20px;padding:2px 9px;color:var(--text);font-size:12px;}');
    S.Add('.toast{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);background:var(--accent2);color:#04281c;padding:10px 16px;border-radius:20px;font-weight:600;font-size:14px;opacity:0;pointer-events:none;transition:opacity .2s;z-index:20;}');
    S.Add('.toast.show{opacity:1;}');
    S.Add('.tag{display:inline-block;background:var(--panel2);border-radius:5px;padding:0 5px;margin-left:6px;font-size:11px;color:var(--accent2);vertical-align:1px;}');
    S.Add('</style>');
    S.Add('</head>');
    S.Add('<body>');
    S.Add('<header>');
    S.Add('<h1>UltraStar <span>Deluxe</span> &middot; Song Requests</h1>');
    S.Add('<div class="row">');
    S.Add('<input id="singer" type="text" placeholder="Your name (optional)" maxlength="40" autocomplete="name">');
    S.Add('</div>');
    S.Add('<div class="row" style="margin-top:8px">');
    S.Add('<input id="search" type="search" placeholder="Search artist, title, genre, year..." autocomplete="off">');
    S.Add('</div>');
    S.Add('</header>');
    S.Add('<main>');
    S.Add('<section>');
    S.Add('<h2>Queue <span class="badge" id="qcount">0</span></h2>');
    S.Add('<ul id="queue"></ul>');
    S.Add('<div class="empty" id="qempty">Nothing queued yet. Pick a song below.</div>');
    S.Add('</section>');
    S.Add('<section>');
    S.Add('<h2>Songs <span class="badge" id="scount">0</span></h2>');
    S.Add('<ul id="songs"></ul>');
    S.Add('<button class="more" id="more" hidden>Show more</button>');
    S.Add('<div class="empty" id="sempty" hidden>No song matches your search.</div>');
    S.Add('</section>');
    S.Add('</main>');
    S.Add('<div class="toast" id="toast"></div>');
    S.Add('<script>');
    S.Add('var PAGE=60;var offset=0;var total=0;var query="";var rev=-1;var timer=null;');
    S.Add('var elSongs=document.getElementById("songs");');
    S.Add('var elQueue=document.getElementById("queue");');
    S.Add('var elMore=document.getElementById("more");');
    S.Add('var elSinger=document.getElementById("singer");');
    S.Add('var elSearch=document.getElementById("search");');
    S.Add('var elToast=document.getElementById("toast");');
    S.Add('try{elSinger.value=localStorage.getItem("usdxSinger")||"";}catch(e){}');
    S.Add('elSinger.addEventListener("change",function(){try{localStorage.setItem("usdxSinger",elSinger.value);}catch(e){}});');
    S.Add('function toast(msg){elToast.textContent=msg;elToast.classList.add("show");');
    S.Add('setTimeout(function(){elToast.classList.remove("show");},1600);}');
    S.Add('function post(url,data){');
    S.Add('var body=Object.keys(data).map(function(k){return encodeURIComponent(k)+"="+encodeURIComponent(data[k]);}).join("&");');
    S.Add('return fetch(url,{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body:body})');
    S.Add('.then(function(r){return r.json();});}');
    S.Add('function songRow(s){');
    S.Add('var li=document.createElement("li");');
    S.Add('var meta=document.createElement("div");meta.className="meta";');
    S.Add('var t=document.createElement("div");t.className="title";t.textContent=s.title;');
    S.Add('if(s.duet){var d=document.createElement("span");d.className="tag";d.textContent="DUET";t.appendChild(d);}');
    S.Add('var sub=document.createElement("div");sub.className="sub";');
    S.Add('var bits=[s.artist];if(s.year){bits.push(s.year);}if(s.language){bits.push(s.language);}');
    S.Add('sub.textContent=bits.join(" · ");');
    S.Add('meta.appendChild(t);meta.appendChild(sub);');
    S.Add('var b=document.createElement("button");b.className="add";b.textContent="+";');
    S.Add('b.setAttribute("aria-label","Add "+s.title+" to the queue");');
    S.Add('b.onclick=function(){b.disabled=true;');
    S.Add('post("/api/queue/add",{id:s.id,singer:elSinger.value}).then(function(res){');
    S.Add('b.disabled=false;');
    S.Add('if(res.ok){toast("Queued: "+s.title);loadQueue(true);}else{toast(res.error||"Could not queue song");}');
    S.Add('}).catch(function(){b.disabled=false;toast("Connection lost");});};');
    S.Add('li.appendChild(meta);li.appendChild(b);return li;}');
    S.Add('function queueRow(e,i,len){');
    S.Add('var li=document.createElement("li");if(i===0){li.className="now";}');
    S.Add('var pos=document.createElement("div");pos.className="pos";pos.textContent=(i+1);');
    S.Add('var meta=document.createElement("div");meta.className="meta";');
    S.Add('var t=document.createElement("div");t.className="title";t.textContent=e.title;');
    S.Add('var sub=document.createElement("div");sub.className="sub";');
    S.Add('sub.textContent=e.singer?e.artist+" · "+e.singer:e.artist;');
    S.Add('meta.appendChild(t);meta.appendChild(sub);');
    S.Add('var up=document.createElement("button");up.className="icon";up.textContent="↑";');
    S.Add('up.setAttribute("aria-label","Move up");up.disabled=(i===0);');
    S.Add('up.onclick=function(){post("/api/queue/move",{entry:e.entry,offset:-1}).then(function(){loadQueue(true);});};');
    S.Add('var dn=document.createElement("button");dn.className="icon";dn.textContent="↓";');
    S.Add('dn.setAttribute("aria-label","Move down");dn.disabled=(i===len-1);');
    S.Add('dn.onclick=function(){post("/api/queue/move",{entry:e.entry,offset:1}).then(function(){loadQueue(true);});};');
    S.Add('var rm=document.createElement("button");rm.className="icon";rm.textContent="×";');
    S.Add('rm.setAttribute("aria-label","Remove from queue");');
    S.Add('rm.onclick=function(){post("/api/queue/remove",{entry:e.entry}).then(function(){loadQueue(true);});};');
    S.Add('li.appendChild(pos);li.appendChild(meta);li.appendChild(up);li.appendChild(dn);li.appendChild(rm);');
    S.Add('return li;}');
    S.Add('function loadQueue(force){');
    S.Add('fetch("/api/queue").then(function(r){return r.json();}).then(function(data){');
    S.Add('if(!force&&data.rev===rev){return;}');
    S.Add('rev=data.rev;');
    S.Add('document.getElementById("qcount").textContent=data.entries.length;');
    S.Add('elQueue.innerHTML="";');
    S.Add('data.entries.forEach(function(e,i){elQueue.appendChild(queueRow(e,i,data.entries.length));});');
    S.Add('document.getElementById("qempty").hidden=data.entries.length>0;');
    S.Add('}).catch(function(){});}');
    S.Add('function loadSongs(reset){');
    S.Add('if(reset){offset=0;elSongs.innerHTML="";}');
    S.Add('var url="/api/songs?offset="+offset+"&limit="+PAGE+"&q="+encodeURIComponent(query);');
    S.Add('fetch(url).then(function(r){return r.json();}).then(function(data){');
    S.Add('total=data.total;');
    S.Add('document.getElementById("scount").textContent=total;');
    S.Add('data.songs.forEach(function(s){elSongs.appendChild(songRow(s));});');
    S.Add('offset+=data.songs.length;');
    S.Add('elMore.hidden=offset>=total;');
    S.Add('document.getElementById("sempty").hidden=total>0;');
    S.Add('}).catch(function(){});}');
    S.Add('elMore.onclick=function(){loadSongs(false);};');
    S.Add('elSearch.addEventListener("input",function(){');
    S.Add('clearTimeout(timer);');
    S.Add('timer=setTimeout(function(){query=elSearch.value;loadSongs(true);},250);});');
    S.Add('loadSongs(true);loadQueue(true);');
    S.Add('setInterval(function(){loadQueue(false);},2500);');
    S.Add('</script>');
    S.Add('</body>');
    S.Add('</html>');

    Result := S.Text;
  finally
    S.Free;
  end;
end;
