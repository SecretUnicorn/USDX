{* The page behind /players: who is singing on which microphone right now.
   Kept separate from the request page, the guests do not need it. *}
function BuildWebPlayersPage: RawByteString;
var
  S: TStringList;
begin
  S := TStringList.Create;
  try
    S.Add('<!doctype html>');
    S.Add('<html lang="en"><head>');
    S.Add('<meta charset="utf-8">');
    S.Add('<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">');
    S.Add('<title>UltraStar Deluxe - Players</title>');
    S.Add('<style>');
    S.Add(':root{--bg:#111420;--panel:#1b2030;--panel2:#232a3d;--line:#2e3752;--text:#e9ecf6;--dim:#98a1bb;--accent:#ffc933;--accent2:#5ad1a0;}');
    S.Add('*{box-sizing:border-box;}');
    S.Add('body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:16px;}');
    S.Add('header{background:var(--panel);border-bottom:1px solid var(--line);padding:10px 12px;}');
    S.Add('h1{margin:0;font-size:17px;}');
    S.Add('h1 span{color:var(--accent);}');
    S.Add('.state{color:var(--dim);font-size:13px;margin-top:4px;}');
    S.Add('.state.live{color:var(--accent2);}');
    S.Add('main{padding:12px;max-width:620px;margin:0 auto;}');
    S.Add('ul{list-style:none;margin:0;padding:0;}');
    S.Add('li{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px;margin-bottom:10px;display:flex;align-items:center;gap:10px;}');
    S.Add('.dot{width:26px;height:26px;border-radius:50%;flex:none;border:2px solid rgba(255,255,255,.35);}');
    S.Add('.who{flex:1;min-width:0;}');
    S.Add('.mic{font-size:12px;color:var(--dim);text-transform:uppercase;letter-spacing:.07em;}');
    S.Add('input{width:100%;background:var(--panel2);border:1px solid var(--line);border-radius:9px;color:var(--text);padding:10px;font-size:16px;margin-top:4px;}');
    S.Add('input:focus{outline:2px solid var(--accent);}');
    S.Add('.score{flex:none;font-weight:700;color:var(--accent);min-width:58px;text-align:right;}');
    S.Add('button{background:var(--accent);border:1px solid var(--accent);border-radius:9px;color:#241d00;font-weight:700;padding:10px 14px;font-size:15px;cursor:pointer;flex:none;}');
    S.Add('button:disabled{opacity:.45;}');
    S.Add('.empty{color:var(--dim);font-size:14px;}');
    S.Add('.toast{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);background:var(--accent2);color:#04281c;padding:10px 16px;border-radius:20px;font-weight:600;font-size:14px;opacity:0;pointer-events:none;transition:opacity .2s;}');
    S.Add('.toast.show{opacity:1;}');
    S.Add('</style>');
    S.Add('</head><body>');
    S.Add('<header>');
    S.Add('<h1>UltraStar <span>Deluxe</span> &middot; Players</h1>');
    S.Add('<div class="state" id="state">...</div>');
    S.Add('</header>');
    S.Add('<main>');
    S.Add('<ul id="players"></ul>');
    S.Add('<div class="empty" id="empty" hidden>No players yet. Start a song first.</div>');
    S.Add('</main>');
    S.Add('<div class="toast" id="toast"></div>');
    S.Add('<script>');
    S.Add('var elList=document.getElementById("players");');
    S.Add('var elState=document.getElementById("state");');
    S.Add('var elEmpty=document.getElementById("empty");');
    S.Add('var elToast=document.getElementById("toast");');
    S.Add('var editing=null;');
    S.Add('function toast(m){elToast.textContent=m;elToast.classList.add("show");');
    S.Add('setTimeout(function(){elToast.classList.remove("show");},1600);}');
    S.Add('function post(url,data){');
    S.Add('var body=Object.keys(data).map(function(k){return encodeURIComponent(k)+"="+encodeURIComponent(data[k]);}).join("&");');
    S.Add('return fetch(url,{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body:body})');
    S.Add('.then(function(r){return r.json();});}');
    S.Add('function row(p,i){');
    S.Add('var li=document.createElement("li");li.dataset.i=i;');
    S.Add('var dot=document.createElement("div");dot.className="dot";dot.style.background=p.rgb;');
    S.Add('dot.title=p.color;li.appendChild(dot);');
    S.Add('var who=document.createElement("div");who.className="who";');
    S.Add('var mic=document.createElement("div");mic.className="mic";');
    S.Add('mic.textContent="Player "+(i+1)+(p.color?" · "+p.color:"");');
    S.Add('var inp=document.createElement("input");inp.type="text";inp.maxLength=40;inp.value=p.name;');
    S.Add('inp.setAttribute("aria-label","Name of player "+(i+1));');
    S.Add('inp.onfocus=function(){editing=i;};');
    S.Add('inp.onblur=function(){editing=null;};');
    S.Add('inp.onkeydown=function(e){if(e.key==="Enter"){inp.blur();save(i,inp);}};');
    S.Add('who.appendChild(mic);who.appendChild(inp);li.appendChild(who);');
    S.Add('var sc=document.createElement("div");sc.className="score";sc.textContent=p.score;');
    S.Add('li.appendChild(sc);');
    S.Add('var b=document.createElement("button");b.textContent="Set";');
    S.Add('b.onclick=function(){save(i,inp);};li.appendChild(b);');
    S.Add('return li;}');
    S.Add('function save(i,inp){');
    S.Add('var name=inp.value.trim();');
    S.Add('if(!name){inp.focus();return;}');
    S.Add('post("/api/players",{p:i,name:name}).then(function(res){');
    S.Add('if(res.ok){toast("Player "+(i+1)+" is "+name);}else{toast("Could not change the name");}');
    S.Add('load();}).catch(function(){toast("Connection lost");});}');
    S.Add('function load(){');
    S.Add('fetch("/api/players").then(function(r){return r.json();}).then(function(data){');
    S.Add('elState.textContent=data.singing?"A song is running - changes count for this song":');
    S.Add('"No song running - changes count for the next one";');
    S.Add('elState.classList.toggle("live",!!data.singing);');
    S.Add('elEmpty.hidden=data.players.length>0;');
    // the row being typed in must not be replaced under the thumb
    S.Add('if(elList.children.length!==data.players.length){elList.innerHTML="";');
    S.Add('data.players.forEach(function(p,i){elList.appendChild(row(p,i));});return;}');
    S.Add('data.players.forEach(function(p,i){');
    S.Add('var li=elList.children[i];');
    S.Add('li.querySelector(".score").textContent=p.score;');
    S.Add('li.querySelector(".dot").style.background=p.rgb;');
    S.Add('if(editing!==i){li.querySelector("input").value=p.name;}});');
    S.Add('}).catch(function(){});}');
    S.Add('load();setInterval(load,2000);');
    S.Add('</script>');
    S.Add('</body></html>');

    Result := S.Text;
  finally
    S.Free;
  end;
end;
