{* The page behind /videos: songs that have a video lying in their folder
   which the txt never mentions, so the game sings them to a still picture.
   One line is missing, and this page writes it. *}
function BuildWebVideoPage: RawByteString;
var
  S: TStringList;
begin
  S := TStringList.Create;
  try
    S.Add('<!doctype html>');
    S.Add('<html lang="en"><head>');
    S.Add('<meta charset="utf-8">');
    S.Add('<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">');
    S.Add('<title>UltraStar Deluxe - Unused videos</title>');
    S.Add('<style>');
    S.Add(':root{--bg:#111420;--panel:#1b2030;--panel2:#232a3d;--line:#2e3752;--text:#e9ecf6;--dim:#98a1bb;--accent:#ffc933;--accent2:#5ad1a0;--danger:#ff7a6b;}');
    S.Add('*{box-sizing:border-box;}');
    S.Add('[hidden]{display:none !important;}');
    S.Add('body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:16px;}');
    S.Add('header{background:var(--panel);border-bottom:1px solid var(--line);padding:10px 12px;}');
    S.Add('h1{margin:0;font-size:17px;}');
    S.Add('h1 span{color:var(--accent);}');
    AddMenuStyle(S);
    S.Add('main{padding:12px;max-width:680px;margin:0 auto;}');
    S.Add('ul{list-style:none;margin:0;padding:0;}');
    S.Add('li{background:var(--panel);border:1px solid var(--line);border-radius:10px;');
    S.Add('padding:10px;margin-bottom:8px;display:flex;gap:10px;align-items:flex-start;}');
    S.Add('li.done{opacity:.55;}');
    S.Add('.meta{flex:1;min-width:0;}');
    S.Add('.song{font-weight:600;overflow-wrap:anywhere;}');
    S.Add('.file{color:var(--accent2);font-size:13px;margin-top:3px;overflow-wrap:anywhere;}');
    S.Add('.where{color:var(--dim);font-size:12px;margin-top:3px;overflow-wrap:anywhere;}');
    S.Add('.bar{display:flex;align-items:center;gap:10px;margin-bottom:8px;}');
    S.Add('.count{color:var(--dim);font-size:13px;flex:1;}');
    S.Add('button{flex:none;background:var(--panel2);border:1px solid var(--accent2);color:var(--accent2);');
    S.Add('font-weight:700;font-size:13px;border-radius:9px;padding:9px 12px;cursor:pointer;}');
    S.Add('button:disabled{opacity:.5;cursor:default;}');
    S.Add(':focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px;}');
    S.Add('.empty{color:var(--dim);font-size:14px;line-height:1.5;}');
    S.Add('.hint{color:var(--dim);font-size:13px;line-height:1.5;margin-top:14px;}');
    S.Add('h2{font-size:13px;text-transform:uppercase;letter-spacing:.09em;');
    S.Add('color:var(--dim);margin:22px 0 8px;font-weight:600;}');
    S.Add('#none li{display:block;padding:8px 10px;}');
    S.Add('</style>');
    S.Add('</head><body>');
    S.Add('<header>');
    AddMenuNav(S, '/videos', 'Unused videos');
    S.Add('</header>');
    S.Add('<main>');
    S.Add('<div class="bar"><div class="count" id="count"></div>');
    S.Add('<button id="all" hidden>Add every tag</button></div>');
    S.Add('<ul id="list"></ul>');
    S.Add('<div class="empty" id="empty" hidden>Nothing to do. Every video in your song folders is named in its txt.</div>');
    S.Add('<h2 id="nonehead" hidden></h2>');
    S.Add('<ul id="none"></ul>');
    S.Add('<div class="hint" id="hint" hidden>Adding the tag writes one #VIDEO line into the song file. ');
    S.Add('Press M in the game&rsquo;s main menu to read the songs again, ');
    S.Add('or it happens by itself at the next start.</div>');
    S.Add('</main>');
    S.Add('<script>');
    S.Add('var elList=document.getElementById("list");');
    S.Add('var elCount=document.getElementById("count");');
    S.Add('var elEmpty=document.getElementById("empty");');
    S.Add('var elHint=document.getElementById("hint");');
    S.Add('var elAll=document.getElementById("all");');
    S.Add('var elNone=document.getElementById("none");');
    S.Add('var elNoneHead=document.getElementById("nonehead");');
    S.Add('var rows=[];');
    S.Add('function fix(x,b,li){');
    S.Add('b.disabled=true;b.textContent="Adding...";');
    S.Add('return fetch("/api/videoless/fix",{method:"POST",');
    S.Add('headers:{"Content-Type":"application/x-www-form-urlencoded"},');
    S.Add('body:"path="+encodeURIComponent(x.path)+"&video="+encodeURIComponent(x.video)})');
    S.Add('.then(function(r){return r.json();}).then(function(d){');
    S.Add('if(d.error){b.disabled=false;b.textContent="Add the tag";alert(d.error);return false;}');
    S.Add('b.textContent="Added";li.className="done";return true;});}');
    S.Add('function row(x){');
    S.Add('var li=document.createElement("li");');
    S.Add('var meta=document.createElement("div");meta.className="meta";');
    S.Add('var n=document.createElement("div");n.className="song";');
    S.Add('n.textContent=x.artist+" - "+x.title;');
    S.Add('var f=document.createElement("div");f.className="file";');
    S.Add('f.textContent=x.video+" is in the folder but not in the txt";');
    S.Add('var p=document.createElement("div");p.className="where";p.textContent=x.path;');
    S.Add('meta.appendChild(n);meta.appendChild(f);meta.appendChild(p);');
    S.Add('var b=document.createElement("button");b.textContent="Add the tag";');
    S.Add('b.onclick=function(){fix(x,b,li);};');
    S.Add('li.appendChild(meta);li.appendChild(b);');
    S.Add('rows.push({song:x,button:b,li:li});');
    S.Add('return li;}');
    // one after the other, so a hundred songs do not open a hundred requests
    S.Add('elAll.onclick=function(){');
    S.Add('elAll.disabled=true;elAll.textContent="Adding...";');
    S.Add('var i=0;');
    S.Add('function next(){');
    S.Add('if(i>=rows.length){elAll.textContent="Done";return;}');
    S.Add('var r=rows[i++];');
    S.Add('fix(r.song,r.button,r.li).then(next);}');
    S.Add('next();};');
    S.Add('function load(){');
    S.Add('fetch("/api/videoless").then(function(r){return r.json();}).then(function(d){');
    S.Add('var songs=d.songs||[];');
    S.Add('elList.innerHTML="";rows=[];');
    S.Add('songs.forEach(function(x){elList.appendChild(row(x));});');
    S.Add('elEmpty.hidden=songs.length>0;');
    S.Add('elHint.hidden=songs.length===0;');
    S.Add('elAll.hidden=songs.length<2;');
    S.Add('elCount.textContent=songs.length===1?"1 song with an unused video":songs.length+" songs with an unused video";');
    // nothing to press here, these songs need a video first
    S.Add('var none=d.none||[];');
    S.Add('elNone.innerHTML="";');
    S.Add('none.forEach(function(x){var li=document.createElement("li");');
    S.Add('var n=document.createElement("div");n.className="song";');
    S.Add('n.textContent=x.artist+" - "+x.title;');
    S.Add('li.appendChild(n);elNone.appendChild(li);});');
    S.Add('elNoneHead.hidden=none.length===0;');
    S.Add('elNoneHead.textContent=none.length+" songs without any video";');
    S.Add('}).catch(function(){});}');
    S.Add('load();');
    S.Add('</script>');
    S.Add('</body></html>');

    Result := S.Text;
  finally
    S.Free;
  end;
end;
